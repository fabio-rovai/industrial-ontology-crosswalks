ido:Site skos:relatedMatch ifc:IfcSite .

ido:Stream skos:relatedMatch ifc:IfcFlowSegment .

ido:System skos:relatedMatch ifc:IfcSystem .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> a sssom:MappingSet ;
    rdfs:label "IDO (ISO 15926-14) to IFC4 ADD2 backbone crosswalk" ;
    rdfs:comment "Candidate-for-review crosswalk between the Industrial Data Ontology (the ISO 15926-14 standardisation-track OWL rendering, POSC Caesar) and ifcOWL IFC4 ADD2 (ISO 16739). Rows with predicate_modifier=Not are asserted NON-mappings: pairs that look alignable and are not. See DIVERGENCES.md for the argument behind each one. Confidence is the curator's, not a computed score." ;
    sssom:license <https://creativecommons.org/licenses/by/4.0/> ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:mapping_set_version "0.1.0" .

