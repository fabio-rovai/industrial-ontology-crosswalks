@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix ifc: <http://ifcowl.openbimstandards.org/IFC4_ADD2#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
