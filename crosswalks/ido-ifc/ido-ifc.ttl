<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/023> a sssom:Mapping ;
    rdfs:comment "The classic process-plant to building trap: the flowing matter versus the conduit that carries it. See DIVERGENCES.md D6." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.4 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
