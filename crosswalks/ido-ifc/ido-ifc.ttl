<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/021> a sssom:Mapping ;
    rdfs:comment "Name-identical, category-incompatible. See DIVERGENCES.md D3." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.45 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
