@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/000> a sssom:Mapping ;
    rdfs:comment "Both standards independently draw an as-built/as-designed line and both make it disjoint: IDO asserts Actual owl:disjointWith Specified, IFC asserts IfcObject owl:disjointWith IfcTypeObject. The occurrence side corresponds. This is the strongest structural agreement between the two models." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.85 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcObject ;
    sssom:object_label "IfcObject" ;
    sssom:predicate_id skos:closeMatch ;
    sssom:subject_id ido:Actual ;
    sssom:subject_label "Actual" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/001> a sssom:Mapping ;
    rdfs:comment "The as-designed side of the same mirrored distinction. Not exact: IDO Specified is a requirement specification carrying restrictions, IFC IfcTypeObject is a catalogue type shared by occurrences. Every IfcTypeObject is Specified; not every Specified individual is a catalogue type." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.8 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcTypeObject ;
    sssom:object_label "IfcTypeObject" ;
    sssom:predicate_id skos:closeMatch ;
    sssom:subject_id ido:Specified ;
    sssom:subject_label "Specified" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/002> a sssom:Mapping ;
    rdfs:comment "Both are the doing/happening notion. Orientation-sensitive: promoting this to owl:equivalentClass is unsafe because IfcProcess is subsumed by IfcObject, which drags activities into the IDO Object branch that IDO declares disjoint from Temporal. See DIVERGENCES.md D1." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.8 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcProcess ;
    sssom:object_label "IfcProcess" ;
    sssom:predicate_id skos:closeMatch ;
    sssom:subject_id ido:Activity ;
    sssom:subject_label "Activity" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/003> a sssom:Mapping ;
    rdfs:comment "IfcProduct is the spatially located physical thing. Narrower than IDO PhysicalObject in one direction (IfcProduct requires placement and representation) and broader in another (IfcAnnotation and IfcGrid are IfcProducts but are not physical objects)." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.75 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcProduct ;
    sssom:object_label "IfcProduct" ;
    sssom:predicate_id skos:closeMatch ;
    sssom:subject_id ido:PhysicalObject ;
    sssom:subject_label "PhysicalObject" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/004> a sssom:Mapping ;
    rdfs:comment "The manufactured, installed physical component. The cleanest domain-level correspondence in the set." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.85 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcElement ;
    sssom:object_label "IfcElement" ;
    sssom:predicate_id skos:closeMatch ;
    sssom:subject_id ido:PhysicalArtefact ;
    sssom:subject_label "PhysicalArtefact" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/005> a sssom:Mapping ;
    rdfs:comment "Direct. Note the asymmetry: IDO Person is subsumed by Organism and thence PhysicalObject and carries that disjointness, whereas IfcPerson sits in the IFC resource layer outside IfcObject entirely and carries no disjointness at all." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.9 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcPerson ;
    sssom:object_label "IfcPerson" ;
    sssom:predicate_id skos:closeMatch ;
    sssom:subject_id ido:Person ;
    sssom:subject_label "Person" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/006> a sssom:Mapping ;
    rdfs:comment "Direct. Same layering asymmetry as Person: IDO makes Organization disjoint from PhysicalObject, InformationObject and Location; IFC asserts nothing." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.9 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcOrganization ;
    sssom:object_label "IfcOrganization" ;
    sssom:predicate_id skos:closeMatch ;
    sssom:subject_id ido:Organization ;
    sssom:subject_label "Organization" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/007> a sssom:Mapping ;
    rdfs:comment "IfcNamedUnit is the named unit with a dimensional exponent. IDO UnitOfMeasure is broader because it also subsumes Scale." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.85 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcNamedUnit ;
    sssom:object_label "IfcNamedUnit" ;
    sssom:predicate_id skos:closeMatch ;
    sssom:subject_id ido:UnitOfMeasure ;
    sssom:subject_label "UnitOfMeasure" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/008> a sssom:Mapping ;
    rdfs:comment "IDO Scale is a subclass of UnitOfMeasure covering ordinal and interval scales. IFC has no scale concept distinct from unit, so this maps into IfcNamedUnit with loss." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.6 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcNamedUnit ;
    sssom:object_label "IfcNamedUnit" ;
    sssom:predicate_id skos:narrowMatch ;
    sssom:subject_id ido:Scale ;
    sssom:subject_label "Scale" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/009> a sssom:Mapping ;
    rdfs:comment "THE CORRECT TARGET for IfcPhysicalQuantity. IfcPhysicalQuantity is a recorded measurement value, which is IDO's QualityDatum (an InformationObject), not IDO's PhysicalQuantity (a Quality). See the asserted non-mapping below and DIVERGENCES.md D4." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.85 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcPhysicalQuantity ;
    sssom:object_label "IfcPhysicalQuantity" ;
    sssom:predicate_id skos:closeMatch ;
    sssom:subject_id ido:QualityDatum ;
    sssom:subject_label "QualityDatum" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/010> a sssom:Mapping ;
    rdfs:comment "IfcQuantityLength is one scalar quantity datum among several (area, volume, count, weight, time). IDO's single ScalarQuantityDatum subsumes all of them." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.8 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcQuantityLength ;
    sssom:object_label "IfcQuantityLength" ;
    sssom:predicate_id skos:broadMatch ;
    sssom:subject_id ido:ScalarQuantityDatum ;
    sssom:subject_label "ScalarQuantityDatum" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/011> a sssom:Mapping ;
    rdfs:comment "The area case of the row above. Note that IfcQuantityLength and IfcQuantityArea are declared disjoint in IFC, so both rows cannot be promoted to equivalence together: the orientation search keeps the first and drops this one. That is the correct outcome and is visible in reasoning/results.json." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.8 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcQuantityArea ;
    sssom:object_label "IfcQuantityArea" ;
    sssom:predicate_id skos:broadMatch ;
    sssom:subject_id ido:ScalarQuantityDatum ;
    sssom:subject_label "ScalarQuantityDatum" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/012> a sssom:Mapping ;
    rdfs:comment "IfcPropertyDefinition (property sets and templates) is information about objects, so it falls inside IDO InformationObject. IDO's class is much broader: it also covers documents, datasets and quality datums." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.7 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcPropertyDefinition ;
    sssom:object_label "IfcPropertyDefinition" ;
    sssom:predicate_id skos:broadMatch ;
    sssom:subject_id ido:InformationObject ;
    sssom:subject_label "InformationObject" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/013> a sssom:Mapping ;
    rdfs:comment "The property-set specialisation of the row above." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.7 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcPropertySetDefinition ;
    sssom:object_label "IfcPropertySetDefinition" ;
    sssom:predicate_id skos:broadMatch ;
    sssom:subject_id ido:InformationObject ;
    sssom:subject_label "InformationObject" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/014> a sssom:Mapping ;
    rdfs:comment "Both denote a dependent shape modification of a host element (a void, a projection). IDO Feature is subsumed by PhysicalObject; IfcFeatureElement is subsumed by IfcElement." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.8 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcFeatureElement ;
    sssom:object_label "IfcFeatureElement" ;
    sssom:predicate_id skos:closeMatch ;
    sssom:subject_id ido:Feature ;
    sssom:subject_label "Feature" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/015> a sssom:Mapping ;
    rdfs:comment "IDO Compound is the stuff an object is materially made of, reached by hasMaterialPart. IfcMaterial is the homogeneous material assigned to an element. Close, but IFC treats material as a resource-layer definition rather than a physical object." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.75 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcMaterial ;
    sssom:object_label "IfcMaterial" ;
    sssom:predicate_id skos:closeMatch ;
    sssom:subject_id ido:Compound ;
    sssom:subject_label "Compound" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/016> a sssom:Mapping ;
    rdfs:comment "Both denote a bounded stretch of time. IFC's is a start/end time pair in the resource layer rather than a first-class temporal region." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.7 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcTimePeriod ;
    sssom:object_label "IfcTimePeriod" ;
    sssom:predicate_id skos:closeMatch ;
    sssom:subject_id ido:Interval ;
    sssom:subject_label "Interval" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/017> a sssom:Mapping ;
    rdfs:comment "IfcActor is a person or organisation acting in a project role, which conflates the bearer with the role. IDO separates them: Role is a Dependent borne by an Object. Related, not equivalent." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.55 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcActor ;
    sssom:object_label "IfcActor" ;
    sssom:predicate_id skos:relatedMatch ;
    sssom:subject_id ido:Role ;
    sssom:subject_label "Role" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/018> a sssom:Mapping ;
    rdfs:comment "IfcProperty is a named value slot, which straddles IDO's Quality (the borne characteristic) and QualityDatum (the recorded value). IFC does not draw that distinction, so no clean subsumption exists in either direction." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.5 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcProperty ;
    sssom:object_label "IfcProperty" ;
    sssom:predicate_id skos:relatedMatch ;
    sssom:subject_id ido:Quality ;
    sssom:subject_label "Quality" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/019> a sssom:Mapping ;
    rdfs:comment "Category clash, not a defect in either model. IDO Location is disjoint from PhysicalObject; IfcSpatialElement is a subclass of IfcProduct, so in IFC a spatial region IS a product. Recorded as related so that tools do not promote it." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
    sssom:confidence 0.5 ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:mapping_set_id <https://w3id.org/tesseract/industrial-crosswalks/ido-ifc> ;
    sssom:object_id ifc:IfcSpatialElement ;
    sssom:object_label "IfcSpatialElement" ;
    sssom:predicate_id skos:relatedMatch ;
    sssom:subject_id ido:Location ;
    sssom:subject_label "Location" .

<https://w3id.org/tesseract/industrial-crosswalks/ido-ifc/mapping/020> a sssom:Mapping ;
    rdfs:comment "Name-identical, structurally incompatible. See the asserted non-mapping below and DIVERGENCES.md D2. Retained as relatedMatch only so that a human reading the crosswalk finds the warning at the point of need." ;
    prov:wasAttributedTo orcid:0009-0001-7244-794X ;
